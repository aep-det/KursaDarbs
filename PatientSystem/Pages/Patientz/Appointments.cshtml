@page
@model PatientSystem.Pages.Patientz.AppointmentsModel
@{
    ViewData["Title"] = "My Appointments";
}

<div class="patientz-theme">
<h1>My Appointments</h1>

<div class="mb-4">
    <h4>Create New Appointment</h4>
    <form method="get" class="mb-3">
        <div class="form-group mb-2">
            <label for="specialityFilter">Speciality</label>
            <select id="specialityFilter" name="speciality" class="form-control" onchange="this.form.submit()">
                <option value="">-- All Specialities --</option>
                @foreach (var spec in Model.Specialities)
                {
                    if (Model.SelectedSpeciality == spec)
                    {
                        <option value="@spec" selected>@spec</option>
                    }
                    else
                    {
                        <option value="@spec">@spec</option>
                    }
                }
            </select>
        </div>
    </form>
    <form method="post">
        <div asp-validation-summary="All" class="alert alert-danger" role="alert" style="display:none;" id="validationSummary"></div>
        <div class="form-group mb-2">
            <label asp-for="NewAppointment.Date" class="control-label">Date</label>
            <input asp-for="NewAppointment.Date" class="form-control" type="date" min="@DateTime.Now.ToString("yyyy-MM-dd")" placeholder="Select appointment date" />
            <small class="form-text text-muted">Choose your preferred appointment date (must be today or later)</small>
            <span asp-validation-for="NewAppointment.Date" class="text-danger small"></span>
        </div>
        <div class="form-group mb-2">
            <label asp-for="NewAppointment.ProfessionalId" class="control-label">Professional</label>
            <select asp-for="NewAppointment.ProfessionalId" class="form-control" asp-items="Model.ProfessionalOptions">
                <option value="">-- Select Professional --</option>
            </select>
            <small class="form-text text-muted">Select a healthcare professional for your appointment</small>
            <span asp-validation-for="NewAppointment.ProfessionalId" class="text-danger small"></span>
        </div>
        <div class="form-group mb-2">
            <label asp-for="NewAppointment.Time" class="control-label">Available Time</label>
            <select asp-for="NewAppointment.Time" class="form-control" asp-items="Model.AvailableTimes">
                <option value="">-- Select Time --</option>
            </select>
            <small class="form-text text-muted">Choose your preferred appointment time slot</small>
            <span asp-validation-for="NewAppointment.Time" class="text-danger small"></span>
        </div>
        <div class="form-group mb-2">
            <label asp-for="NewAppointment.Status" class="control-label">Status</label>
            <input asp-for="NewAppointment.Status" class="form-control" placeholder="e.g., scheduled" />
            <span asp-validation-for="NewAppointment.Status" class="text-danger small"></span>
        </div>
        <button type="submit" class="btn btn-primary" id="submitBtn">
            <span id="btnText">Schedule Appointment</span>
            <span id="spinner" class="spinner-border spinner-border-sm ms-2" role="status" aria-hidden="true" style="display:none;"></span>
        </button>
    </form>
</div>

@if (Model.Appointments != null && Model.Appointments.Count > 0)
{
    <table class="table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Time</th>
                <th>Status</th>
                <th>Professional</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var appt in Model.Appointments)
        {
            <tr>
                <td>@appt.Date.ToShortDateString()</td>
                <td>@appt.Time</td>
                <td>@appt.Status</td>
                <td>@appt.Professional?.Name</td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <p>No appointments found.</p>
}

</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
