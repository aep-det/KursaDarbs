@page
@model PatientSystem.Pages.Proffesionalz.IndexModel

@{
    ViewData["Title"] = "Professionals";
}

<div class="proffesionalz-theme">
    <section>
        <h1>
            <i class="fas fa-stethoscope me-2"></i>Healthcare Professionals
        </h1>
        <p class="text-muted">Manage healthcare professional records</p>
    </section>

    <div class="mb-4">
        <a asp-page="Create" class="btn btn-primary" aria-label="Create a new healthcare professional record">
            <i class="fas fa-plus me-2"></i>Add Professional
        </a>
    </div>

    @if (Model.Professional != null && Model.Professional.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th scope="col">
                            @Html.DisplayNameFor(model => model.Professional[0].Name)
                        </th>
                        <th scope="col">
                            @Html.DisplayNameFor(model => model.Professional[0].Email)
                        </th>
                        <th scope="col">
                            @Html.DisplayNameFor(model => model.Professional[0].Specialization)
                        </th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Professional)
                    {
                        <tr>
                            <td>
                                <i class="fas fa-user-md text-medical-secondary me-2"></i>@Html.DisplayFor(modelItem => item.Name)
                            </td>
                            <td>
                                <i class="fas fa-envelope text-muted me-2"></i>@Html.DisplayFor(modelItem => item.Email)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Specialization)
                            </td>
                            <td>
                                <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-success" aria-label="Edit professional @item.Name">
                                    <i class="fas fa-edit me-1"></i>Edit
                                </a>
                                <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" aria-label="View details for @item.Name">
                                    <i class="fas fa-eye me-1"></i>Details
                                </a>
                                <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" aria-label="Delete professional @item.Name">
                                    <i class="fas fa-trash me-1"></i>Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Page navigation" class="mt-4">
                <ul class="pagination justify-content-center">
                    @if (Model.PageNumber > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-page="./Index" asp-route-pageNumber="@(Model.PageNumber - 1)" aria-label="Go to previous page">
                                <i class="fas fa-chevron-left me-1"></i>Previous
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">
                            <span class="page-link">
                                <i class="fas fa-chevron-left me-1"></i>Previous
                            </span>
                        </li>
                    }
                    
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        @if (i >= Model.PageNumber - 2 && i <= Model.PageNumber + 2)
                        {
                            @if (i == Model.PageNumber)
                            {
                                <li class="page-item active">
                                    <span class="page-link" aria-current="page">@i</span>
                                </li>
                            }
                            else
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-page="./Index" asp-route-pageNumber="@i" aria-label="Go to page @i">@i</a>
                                </li>
                            }
                        }
                    }
                    
                    @if (Model.PageNumber < Model.TotalPages)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-page="./Index" asp-route-pageNumber="@(Model.PageNumber + 1)" aria-label="Go to next page">
                                Next <i class="fas fa-chevron-right ms-1"></i>
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">
                            <span class="page-link">
                                Next <i class="fas fa-chevron-right ms-1"></i>
                            </span>
                        </li>
                    }
                </ul>
            </nav>
            <p class="text-muted text-center small mt-3">
                Showing <strong>@Model.Professional.Count</strong> of <strong>@Model.TotalRecords</strong> professionals | 
                Page <strong>@Model.PageNumber</strong> of <strong>@Model.TotalPages</strong>
            </p>
        }
    }
    else
    {
        <div class="alert alert-info" role="alert">
            <i class="fas fa-info-circle me-2"></i>No professionals found. <a asp-page="Create">Add a new professional</a>.
        </div>
    }
</div>
